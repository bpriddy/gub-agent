# Deploy-time env baked into the SANDBOX reasoning engine by
# deployment/deploy-sandbox.sh (`adk deploy --env_file`). This file is what
# makes that engine a sandbox: the production engine is deployed from
# deploy-dev.env, which carries SANDBOX_ENABLED=0, so an override aimed at an
# experiment can never take effect on the engine serving the Chat bot.
#
# Everything else comes from config.py defaults; the model location is pinned
# in code (config.py). Keep this minimal and secret-free — it ships into the
# engine.

# Emit executor + critic thinking summaries in the event stream (debug client).
EMIT_THINKING=1

# Honour state["sandbox"] — per-call prompt / model / thinking / temperature
# overrides (gub_agent/sandbox.py). NEVER set this in deploy-dev.env.
SANDBOX_ENABLED=1

# Models a sandbox run may select. Only ids that answer from this project's
# Vertex GLOBAL endpoint — a 404 inside the engine reaches the caller as an
# empty 200 stream, not an error. Probed with generateContent on 2026-09-09:
#   answer:  gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3-flash-preview,
#            gemini-2.5-pro, gemini-2.5-flash, gemini-2.5-flash-lite
#   404:     gemini-3.5-pro, gemini-3-pro(-preview), gemini-3-flash (non-preview)
# gemini-3-flash-preview is a preview id — drop it here when Google retires it.
#
# Anthropic on Vertex (gub_agent/models.py routes `claude-*` ids to ADK's Claude
# client, location CLAUDE_VERTEX_LOCATION=global) requires the Anthropic models
# to be ENABLED for the project in Model Garden (console questionnaire); until
# then Vertex answers 404 "does not have access" and the run is an empty stream.
# TEMPORARILY REMOVED from the allowlist (2026-09-09, user decision): a model
# that can only fail confuses testers. The router stays; when Model Garden
# access exists, append `,claude-sonnet-5,claude-haiku-4-5` here and redeploy
# (deployment/deploy-sandbox.sh). Claude ids are never in
# SANDBOX_THINKING_LEVEL_MODELS: Anthropic has no named levels, DYNAMIC =
# adaptive thinking.
SANDBOX_MODEL_ALLOWLIST=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite
# Of those, the ones that accept a NAMED thinking_level (the 3-series; every
# 2.5 id answers 400 "thinking_level is not supported"). A run that swaps to any
# other model must set DYNAMIC on both roles or it is refused (sandbox.py).
SANDBOX_THINKING_LEVEL_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-flash-preview

# Filled in by the first run of deployment/deploy-sandbox.sh. Empty → the
# script CREATES a new engine (Agent Engine bills per engine); set → the script
# updates that engine in place. Must never be the prod engine id
# 9136379226620952576 — the script refuses if it is.
SANDBOX_AGENT_ENGINE_ID=9148206673200939008

# Conversation window: the default number of COMPLETE turns a model round is
# shown, for a session whose state carries no `context_turn_window`. Explicit
# for the same reason as in deploy-prod.env — 0 is the rollback and should be
# a line already in front of whoever needs it — and at the same value, so a
# sandbox run without the key measures what production does. A run that wants
# a different window sets `context_turn_window` in its session state instead;
# that needs no redeploy and no sandbox override.
CONTEXT_TURN_WINDOW=10

# Drive file-NAME search (search-01). Off here too, explicitly: the default is
# off and a sandbox that silently inherited it would look like a broken tool
# rather than a switched-off one. Flip to 1 to exercise `find_files` on the
# sandbox engine — but only once the dev GUB this engine calls has FILE_SEARCH
# on, because a disabled backend answers `200 []` and the tool reads that as
# "no such file".
FILE_SEARCH_ENABLED=1

# The critic beside the format gate — same value as deploy-prod.env, so a
# sandbox run measures the pipeline production runs. 0 restores the serial
# tree (the tree only); see the comment there.
CRITIC_PARALLEL=1

# No critic LLM on the loop's last iteration — same value as deploy-prod.env.
# 0 runs the critic on the retry again; see the comment there.
CRITIC_SKIP_FINAL_PASS=1

# Thinking off for the router and the formatter — same values as
# deploy-prod.env; see the comment there. A run still overrides either per call
# (router_thinking_level / formatter_thinking_level, OFF included). Unlike
# production this engine has EMIT_THINKING=1; with thinking off the planner still
# sends include_thoughts=false, so the zero budget never pairs with a summary.
ROUTER_THINKING_OFF=1
FORMATTER_THINKING_OFF=1

# The deep path starts beside the router instead of after it
# (gub_agent/agents/speculation.py): on a deep turn the router's call — p50 5.8 /
# p90 28 s in production, its first token sometimes stalling 10-67 s inside
# Vertex — is hidden behind the executor's. On any other branch the speculative
# run is cancelled. 1 is the default; 0 is the ROLLBACK, the plain
# [router, dispatcher] tree. Read at import: a redeploy either way.
#
# The price: a non-deep turn (about a third of anomaly production turns,
# 2026-09-17..24) throws away however far the speculation got — not 1-2
# executor rounds but, behind a stalled router, possibly the whole deep path,
# GUB calls included (they count against the per-subject rate limit). A
# file_lookup turn (~10% of deep turns, file search on) always restarts and
# saves about nothing.
#
# Watch `speculation: outcome=… lead_ms=… tenant=…`: `kept` is the saving,
# `cancelled:*` / `restarted:*` the price. One per `dispatcher: intent` line,
# plus `cancelled:aborted`: a caller that left before the router answered, the
# one outcome with no decision line. Kept because a router stalled past the
# caller's deadline is where the speculation costs most; drop it from the
# numerator of any proportion over `dispatcher: intent`.
#
# The speculative run logs like any deep run — turn_window, model_call,
# format_gate, the limiter's lines, same inv= and tenant= — so every one of its
# lines ends in ` spec=1`. Count such a line only when its inv's
# `speculation: outcome=kept`; on any other outcome it is thrown-away work, not
# traffic. Only the call in flight at the cancel logs
# `model_call … status=error:cancelled`; the rounds it had finished log
# status=ok.
SPECULATIVE_DEEP=1

# A fast-path decision the lookup would decline in code keeps the speculative
# deep run — same value as deploy-prod.env; see the comment there. 0 is the
# ROLLBACK here as there: today's stop-and-restart.
SPECULATIVE_FAST_PRECHECK=1

# One Vertex API client per event loop for the agentengine:// session service
# (services.py at the repo root, staged by --extra_packages and imported by
# `adk api_server` at start). ADK 2.9.2 builds a new vertexai.Client for every
# session call — each append_event and get_session — and closes it after the
# one request: ~100 ms of CPU per build (three SSL contexts), then ADC, a token
# and a fresh TLS handshake, ~13 times on a deep turn, every one awaited by the
# Runner before the agent continues. With 1 each turn's loop builds one client
# and closes it when the loop shuts down. The requests are identical, argument
# for argument; only the client object is kept. The code default is 0; 1 here
# because this engine deploys only by hand, so the value ships with the deploy
# that is meant to carry it. 0 is the ROLLBACK: nothing is registered and ADK's
# own factory builds the stock service. Read at server start: a redeploy.
#
# Watch at the first process start: `session_client_reuse: on` and then
# `session service=PerLoopClientSessionService`; their absence (or ADK's
# "Failed to load services.py" WARNING) means the stock service is running.
# After it: the engine's `AppendEvent`/`GetSession` error rate in Monitoring
# (it must not rise) and the inter-event gaps in sessions/{id}/events.
SESSION_CLIENT_REUSE=1

# The router hedge — same value as deploy-prod.env; see the comment there. A
# run's per-call overrides (model, thinking level, prompt) reach the second
# request too: it is a copy of the first one's request, taken after the
# overrides were applied. 0 is the ROLLBACK here as there.
ROUTER_HEDGE_AFTER_MS=4000

# Import at package load what ADK would import on the first model request
# (gub_agent/eager_imports.py): the anthropic SDK behind ADK's content builder,
# genai's async client stack, ADK's auth / compaction / workflow modules —
# 2,115 modules a fresh process imports on its first turn and never again
# (~2.5 s locally; the first request of a production process waited 6.2-16.4 s
# before its first model send, 2026-09-17..25). Imports only: nothing is
# constructed or called. The package loads on the first request of any kind,
# so the cost moves off the first user turn onto whatever comes first after a
# restart — the deploy workflow's warm-up, and the 10-min ping in
# gcp-universal-backend terraform/engine_warmup.tf. 1 is the config.py default;
# 0 is the ROLLBACK: today's lazy imports. Read at import: a redeploy either way.
#
# Watch `eager_imports: imported=… skipped=… new_modules=… ms=…` once per
# process start (skipped > 0 means an ADK/genai upgrade renamed a module and
# that part is lazy again), and the gap between a process's first real turn
# and its first `model_call:` line.
EAGER_ADK_IMPORTS=1
