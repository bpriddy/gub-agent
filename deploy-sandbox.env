# Deploy-time env baked into the SANDBOX reasoning engine by
# deployment/deploy-sandbox.sh (`adk deploy --env_file`). This file is what
# makes that engine a sandbox: the production engine is deployed from
# deploy-dev.env, which carries SANDBOX_ENABLED=0, so an override aimed at an
# experiment can never take effect on the engine serving the Chat bot.
#
# Everything else comes from config.py defaults; the model location is pinned
# in code (config.py). Keep this minimal and secret-free — it ships into the
# engine.

# Emit executor + critic thinking summaries in the event stream (debug client).
EMIT_THINKING=1

# Honour state["sandbox"] — per-call prompt / model / thinking / temperature
# overrides (gub_agent/sandbox.py). NEVER set this in deploy-dev.env.
SANDBOX_ENABLED=1

# Models a sandbox run may select. Only ids that answer from this project's
# Vertex GLOBAL endpoint — a 404 inside the engine reaches the caller as an
# empty 200 stream, not an error. Probed with generateContent on 2026-09-09:
#   answer:  gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3-flash-preview,
#            gemini-2.5-pro, gemini-2.5-flash, gemini-2.5-flash-lite
#   404:     gemini-3.5-pro, gemini-3-pro(-preview), gemini-3-flash (non-preview)
# gemini-3-flash-preview is a preview id — drop it here when Google retires it.
SANDBOX_MODEL_ALLOWLIST=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite
# Of those, the ones that accept a NAMED thinking_level (the 3-series; every
# 2.5 id answers 400 "thinking_level is not supported"). A run that swaps to any
# other model must set DYNAMIC on both roles or it is refused (sandbox.py).
SANDBOX_THINKING_LEVEL_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-flash-preview

# Filled in by the first run of deployment/deploy-sandbox.sh. Empty → the
# script CREATES a new engine (Agent Engine bills per engine); set → the script
# updates that engine in place. Must never be the prod engine id
# 9136379226620952576 — the script refuses if it is.
SANDBOX_AGENT_ENGINE_ID=9148206673200939008
