# Deploy-time env baked into the reasoning engine by `adk deploy --env_file`.
#
# NAMING CAVEAT: despite the name, this is the file the GitHub Actions Deploy
# workflow (.github/workflows/deploy.yml) bakes into the ONE engine that serves
# the Chat bot and the Gemini Enterprise registration — i.e. production. The
# sandbox engine uses deploy-sandbox.env instead; never point the sandbox
# deploy at this file, and never turn SANDBOX_ENABLED on here.
#
# Everything else comes from config.py defaults; the model location is pinned
# in code (config.py) because it's a property of the model, not the
# environment. Keep this minimal and secret-free — it ships into the engine.
EMIT_THINKING=1

# Explicit, not defaulted: the production engine must ignore state["sandbox"]
# outright (gub_agent/sandbox.py). Isolation between experiments and live
# users is a property of THIS line, not of caller discipline.
SANDBOX_ENABLED=0
