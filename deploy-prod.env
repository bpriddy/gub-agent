# Deploy-time env baked into the PRODUCTION reasoning engine
# (9136379226620952576) by .github/workflows/deploy.yml via `adk deploy
# --env_file`. This is the engine the Chat bot and the Gemini Enterprise
# registration point at — there is no separate "dev" engine on this path.
#
# The file used to be called deploy-dev.env: it was written (2026-07-17) for an
# engine that was still a test rig, and that engine quietly became production
# when the Chat bot shipped. The name outlived the fact and invited edits meant
# for a dev engine. Renamed so the next editor cannot make that mistake.
#
# Everything not set here comes from config.py defaults; the model location is
# pinned in code because it is a property of the model, not the environment.
# Keep this minimal and secret-free — it ships into the engine.
#
# EMIT_THINKING: the file carried =1 for its whole life and NEVER reached the
# engine (relative --env_file, silently dropped — see deploy.yml), so production
# has always run on the default: off. Pinned to 0 here so that fixing the path
# changes nothing observable. Flipping it to 1 now actually lands: the Chat bot
# filters thought parts (src/agent/client.ts:336) so users would see nothing new,
# but the summaries would reach every other consumer of the engine, Gemini
# Enterprise included, and grow every event payload. That is a decision to take
# deliberately, not a side effect of a path fix.
EMIT_THINKING=0

# The sandbox is a property of the deploy, not of callers: this flag is what
# makes production ignore a `state.sandbox` override entirely. Explicit, because
# a missing key would also read as off and would not record the intent.
# CI pins this (tests/unit/test_deploy_env_isolation.py).
SANDBOX_ENABLED=0

# Conversation window (memory-00 §3): how many COMPLETE turns of transcript a
# model round is shown. Stated here rather than left to the config.py default
# because it is the ROLLBACK for this feature: 0 disables the window with no
# code change, and an operator under pressure should be editing a line that is
# already in front of them, not discovering that the variable exists.
#
# Since thread-topics this is the DEFAULT, not the value: the Chat bot sends a
# per-session window in state (`context_turn_window`: 10 top-level, 200 in a
# thread), which the executor, router and critic all honour. This number
# reaches every session WITHOUT one — the Chevy tenant bot's older image on
# this same engine, gub-sandbox-ui, the /blend harness. Keep it finite for
# them. 0 here still disables the window everywhere, per-session values
# included; a rollback a session could outvote would roll nothing back.
#
# Watch `turn_window: agent=… window=… source=… turns=… tenant=…` after a
# deploy — one line per windowed model call, `source=state` for bot sessions
# that carry the key. The executor-only `context_window: turns=… window=…
# kept=… dropped=…` line still fires when a cut happens. If `turns` is 4-7x
# the real conversation length, the foreign-context filter is not working and
# the window is cutting inside a single turn: set this to 0.
CONTEXT_TURN_WINDOW=10

# Drive file-NAME search (search-01): whether the executor is ever offered the
# `find_files` tool. Off, and it must STAY off until the GUB this engine calls
# has its own FILE_SEARCH flag on — while that is off `/org/files/search`
# answers `200 []`, which the tool cannot tell apart from a genuine miss, so an
# engine switched on first would report files GUB holds as "not found by name".
# Turning this on is therefore a second step after the backend, never part of
# the same deploy. Off also means the tool declaration is not transmitted on
# any ReAct round, so the feature costs nothing until it is wanted.
FILE_SEARCH_ENABLED=1

# The critic beside the format gate (latency stage 1): the critic LLM runs while
# the formatter renders instead of after it, and a resolver makes the critic
# gate's decisions after the join (gub_agent/agent.py:build_deep_agent). 1 is
# the config.py default; stated here because 0 is the ROLLBACK of the tree —
# the serial one it replaced, [executor, format_gate, critic_gate,
# loop_escalator], with no code change. It rolls back the tree only: the
# last-pass skip is CRITIC_SKIP_FINAL_PASS below, and the serial gate keeps
# reading this pass's payload rather than a stale one from state (a fix, kept
# in both wirings). Read at import, so either way it takes a redeploy.
#
# Watch `critic_speculation: verdict discarded … tenant=…` after a deploy: one
# line per critic call spent on a turn the gate then settled in code (an
# abstain payload). Against the turn count, that is the price of the overlap.
CRITIC_PARALLEL=1

# No critic LLM on the deep loop's last iteration, where its verdict cannot buy
# another pass: the gate writes a sufficient one in code, authored `critic`
# (gub_agent/agents/critic.py:_is_final_pass). 1 is the config.py default; 0 is
# its ROLLBACK — the critic LLM judges the retry again, as before — in either
# wiring, independent of CRITIC_PARALLEL. Read at import: a redeploy either way.
#
# Watch `critic_gate: final pass — critic LLM skipped (inv=…) tenant=…`: one
# line per retried deep turn whose second critic call was saved.
CRITIC_SKIP_FINAL_PASS=1

# Thinking off (thinking_budget=0) for the router and the formatter, instead of
# thinking_level=LOW (gub_agent/config.py has the replay behind it: the router's
# TTFT p90 3.2 s -> 1.1 s). 1 is the config.py default; 0 is each one's ROLLBACK,
# LOW as before. Read at import: a redeploy either way.
#
# The formatter at budget 0 was not replayed for quality. Watch `format_gate:
# attempt … rejected … tenant=…` against `model_call: agent=formatter` after a
# deploy — a rise means the renderer needed the thinking; set its flag to 0.
ROUTER_THINKING_OFF=1
FORMATTER_THINKING_OFF=1

# The deep path starts beside the router instead of after it
# (gub_agent/agents/speculation.py): on a deep turn the router's call — p50 5.8 /
# p90 28 s in production, its first token sometimes stalling 10-67 s inside
# Vertex — is hidden behind the executor's. On any other branch the speculative
# run is cancelled. 1 is the default; 0 is the ROLLBACK, the plain
# [router, dispatcher] tree. Read at import: a redeploy either way.
#
# The price: a non-deep turn (about a third of anomaly production turns,
# 2026-09-17..24) throws away however far the speculation got — not 1-2
# executor rounds but, behind a stalled router, possibly the whole deep path,
# GUB calls included (they count against the per-subject rate limit). A
# file_lookup turn (~10% of deep turns, file search on) always restarts and
# saves about nothing.
#
# Watch `speculation: outcome=… lead_ms=… tenant=…`: `kept` is the saving,
# `cancelled:*` / `restarted:*` the price. One per `dispatcher: intent` line,
# plus `cancelled:aborted`: a caller that left before the router answered, the
# one outcome with no decision line. Kept because a router stalled past the
# caller's deadline is where the speculation costs most; drop it from the
# numerator of any proportion over `dispatcher: intent`.
#
# The speculative run logs like any deep run — turn_window, model_call,
# format_gate, the limiter's lines, same inv= and tenant= — so every one of its
# lines ends in ` spec=1`. Count such a line only when its inv's
# `speculation: outcome=kept`; on any other outcome it is thrown-away work, not
# traffic. Only the call in flight at the cancel logs
# `model_call … status=error:cancelled`; the rounds it had finished log
# status=ok.
SPECULATIVE_DEEP=1

# One Vertex API client per event loop for the agentengine:// session service
# (services.py at the repo root, staged by --extra_packages and imported by
# `adk api_server` at start). ADK 2.9.2 builds a new vertexai.Client for every
# session call — each append_event and get_session — and closes it after the
# one request: ~100 ms of CPU per build (three SSL contexts), then ADC, a token
# and a fresh TLS handshake, ~13 times on a deep turn, every one awaited by the
# Runner before the agent continues. With 1 each turn's loop builds one client
# and closes it when the loop shuts down. The requests are identical, argument
# for argument; only the client object is kept. The code default is 0; 1 here
# because this engine deploys only by hand, so the value ships with the deploy
# that is meant to carry it. 0 is the ROLLBACK: nothing is registered and ADK's
# own factory builds the stock service. Read at server start: a redeploy.
#
# Watch at the first process start: `session_client_reuse: on` and then
# `session service=PerLoopClientSessionService`; their absence (or ADK's
# "Failed to load services.py" WARNING) means the stock service is running.
# After it: the engine's `AppendEvent`/`GetSession` error rate in Monitoring
# (it must not rise) and the inter-event gaps in sessions/{id}/events.
SESSION_CLIENT_REUSE=1

# A router call with no first chunk after this many milliseconds is sent a
# second time — the same model, the same request, the same config — and the
# stream that answers first is relayed; the other is cancelled
# (gub_agent/models.py, "The router hedge"). The router's first token
# sometimes waits 10-67 s inside Vertex, on some days and not others, and a
# replay of stalled production requests did not stall: it is the server's
# condition, not the request's. From router request build (turn_window /
# the ADK send line) to `dispatcher: intent`, tenant=anomaly, 2026-09-17..25:
# p50 4.1 s / p90 28.3 s (n=109); over 4 s on 57 turns, 26 of them not deep;
# over 10 s on 32, 17 not deep. The deep path already hides the router
# (SPECULATIVE_DEEP); the hedge is for the turns that wait for it —
# smalltalk, abstain, clarify, the fast path. Healthy router TTFT with thinking
# off is p90 1.1 s, so 4000 fires only on a call already ~4x late.
# 4000 is the config.py default; 0 is the ROLLBACK — nothing is ever sent
# twice, every call takes today's path byte for byte. Read at import: a
# redeploy either way.
#
# The price: one extra router call on the calls it fires on, never otherwise.
# The router prompt is uncached — 2.6k tokens in a short session, ~20k in a
# long one (prod model_call prompt=, cached=0) — so ~$0.004-0.03 per fire at
# the Flash input rate; 57 fires over the window above would have been
# ~$1.7 at most. The hedge cannot tell a deep turn in advance, so it also
# fires on deep turns the speculative path already covers. A call genai is
# already retrying (429/5xx) is not hedged and a hedge is sent at most once
# per call; once it has fired, each request may still retry on its own
# budget (each line's retries=).
#
# Watch, with the same tenant= clause on numerator and denominator:
# - the share of `model_call: agent=router` lines with dur_ms > 10000, per day
#   (the second request's line ends in ` hedge=1`; add
#   NOT textPayload:"hedge=1" to count one line per call). It should fall on
#   stall days; the loser's line says status=error:cancelled.
# - `router_hedge: fired=1 winner=… primary_ttft_ms=… hedge_ttft_ms=… inv=…
#   tenant=…` against `dispatcher: intent`: the share of turns that paid for a
#   second router call. winner=hedge is a rescue; winner=primary a call that
#   was late but answered first anyway; winner=- neither answered.
ROUTER_HEDGE_AFTER_MS=4000

# Import at package load what ADK would import on the first model request
# (gub_agent/eager_imports.py): the anthropic SDK behind ADK's content builder,
# genai's async client stack, ADK's auth / compaction / workflow modules —
# 2,115 modules a fresh process imports on its first turn and never again
# (~2.5 s locally; the first request of a production process waited 6.2-16.4 s
# before its first model send, 2026-09-17..25). Imports only: nothing is
# constructed or called. The package loads on the first request of any kind,
# so the cost moves off the first user turn onto whatever comes first after a
# restart — the deploy workflow's warm-up, and the 10-min ping in
# gcp-universal-backend terraform/engine_warmup.tf. 1 is the config.py default;
# 0 is the ROLLBACK: today's lazy imports. Read at import: a redeploy either way.
#
# Watch `eager_imports: imported=… skipped=… new_modules=… ms=…` once per
# process start (skipped > 0 means an ADK/genai upgrade renamed a module and
# that part is lazy again), and the gap between a process's first real turn
# and its first `model_call:` line.
EAGER_ADK_IMPORTS=1

# Stream the evidence index to the bot (latency-04 A4): the format gate yields
# ONE partial event per run — authored format_gate, no content,
# custom_metadata={"evidence_rows": [{evidence_id, entity_id, field, value}, …]}
# in index order — so the bot's claim filter can start on the facts the
# formatter will cite (bot flag CLAIM_FILTER_CITATIONS_EARLY). Partial events
# are streamed, never appended: session events, state, history and billing
# are unchanged, and a bot without the flag skips format_gate partials, as it
# always has. This engine serves both bots; for either, the event changes no
# content until its own flag reads it — but every bot counts it: its turn
# line's gubRawEvents (and the sandbox batch record's `events`) go up by one
# per gate run from this deploy on, so cut before/after series of those keys
# here. 0 is the config.py default and the ROLLBACK (no event). Read at
# import: a redeploy either way.
#
# Watch `evidence_rows: n=… bytes=… inv=… tenant=…` once per gate run (logged
# from evidence_index.py, so `textPayload:"format_gate"` does not see it).
# Delivery check, once the bot runs CLAIM_FILTER_CITATIONS_EARLY (its turn
# line has evidenceRowsAtMs only then): every n>0 line's inv should appear on
# a bot turn line (engineInvocationId) with a non-null evidenceRowsAtMs —
# counting a ` spec=1` line only when that inv's `speculation: outcome=` is
# `kept` (a cancelled or restarted speculation's rows were never relayed, and
# a restarted turn logs two lines for one inv).
EVIDENCE_ROWS_EVENT=1
