# Deploy-time env baked into the PRODUCTION reasoning engine
# (9136379226620952576) by .github/workflows/deploy.yml via `adk deploy
# --env_file`. This is the engine the Chat bot and the Gemini Enterprise
# registration point at — there is no separate "dev" engine on this path.
#
# The file used to be called deploy-dev.env: it was written (2026-07-17) for an
# engine that was still a test rig, and that engine quietly became production
# when the Chat bot shipped. The name outlived the fact and invited edits meant
# for a dev engine. Renamed so the next editor cannot make that mistake.
#
# Everything not set here comes from config.py defaults; the model location is
# pinned in code because it is a property of the model, not the environment.
# Keep this minimal and secret-free — it ships into the engine.
#
# EMIT_THINKING: the file carried =1 for its whole life and NEVER reached the
# engine (relative --env_file, silently dropped — see deploy.yml), so production
# has always run on the default: off. Pinned to 0 here so that fixing the path
# changes nothing observable. Flipping it to 1 now actually lands: the Chat bot
# filters thought parts (src/agent/client.ts:336) so users would see nothing new,
# but the summaries would reach every other consumer of the engine, Gemini
# Enterprise included, and grow every event payload. That is a decision to take
# deliberately, not a side effect of a path fix.
EMIT_THINKING=0

# The sandbox is a property of the deploy, not of callers: this flag is what
# makes production ignore a `state.sandbox` override entirely. Explicit, because
# a missing key would also read as off and would not record the intent.
# CI pins this (tests/unit/test_deploy_env_isolation.py).
SANDBOX_ENABLED=0

# Conversation window (memory-00 §3): how many COMPLETE turns of transcript a
# model round is shown. Stated here rather than left to the config.py default
# because it is the ROLLBACK for this feature: 0 disables the window with no
# code change, and an operator under pressure should be editing a line that is
# already in front of them, not discovering that the variable exists.
#
# Since thread-topics this is the DEFAULT, not the value: the Chat bot sends a
# per-session window in state (`context_turn_window`: 10 top-level, 200 in a
# thread), which the executor, router and critic all honour. This number
# reaches every session WITHOUT one — the Chevy tenant bot's older image on
# this same engine, gub-sandbox-ui, the /blend harness. Keep it finite for
# them. 0 here still disables the window everywhere, per-session values
# included; a rollback a session could outvote would roll nothing back.
#
# Watch `turn_window: agent=… window=… source=… turns=… tenant=…` after a
# deploy — one line per windowed model call, `source=state` for bot sessions
# that carry the key. The executor-only `context_window: turns=… window=…
# kept=… dropped=…` line still fires when a cut happens. If `turns` is 4-7x
# the real conversation length, the foreign-context filter is not working and
# the window is cutting inside a single turn: set this to 0.
CONTEXT_TURN_WINDOW=10

# Drive file-NAME search (search-01): whether the executor is ever offered the
# `find_files` tool. Off, and it must STAY off until the GUB this engine calls
# has its own FILE_SEARCH flag on — while that is off `/org/files/search`
# answers `200 []`, which the tool cannot tell apart from a genuine miss, so an
# engine switched on first would report files GUB holds as "not found by name".
# Turning this on is therefore a second step after the backend, never part of
# the same deploy. Off also means the tool declaration is not transmitted on
# any ReAct round, so the feature costs nothing until it is wanted.
FILE_SEARCH_ENABLED=1

# The critic beside the format gate (latency stage 1): the critic LLM runs while
# the formatter renders instead of after it, and a resolver makes the critic
# gate's decisions after the join (gub_agent/agent.py:build_deep_agent). 1 is
# the config.py default; stated here because 0 is the ROLLBACK of the tree —
# the serial one it replaced, [executor, format_gate, critic_gate,
# loop_escalator], with no code change. It rolls back the tree only: the
# last-pass skip is CRITIC_SKIP_FINAL_PASS below, and the serial gate keeps
# reading this pass's payload rather than a stale one from state (a fix, kept
# in both wirings). Read at import, so either way it takes a redeploy.
#
# Watch `critic_speculation: verdict discarded … tenant=…` after a deploy: one
# line per critic call spent on a turn the gate then settled in code (an
# abstain payload). Against the turn count, that is the price of the overlap.
CRITIC_PARALLEL=1

# No critic LLM on the deep loop's last iteration, where its verdict cannot buy
# another pass: the gate writes a sufficient one in code, authored `critic`
# (gub_agent/agents/critic.py:_is_final_pass). 1 is the config.py default; 0 is
# its ROLLBACK — the critic LLM judges the retry again, as before — in either
# wiring, independent of CRITIC_PARALLEL. Read at import: a redeploy either way.
#
# Watch `critic_gate: final pass — critic LLM skipped (inv=…) tenant=…`: one
# line per retried deep turn whose second critic call was saved.
CRITIC_SKIP_FINAL_PASS=1

# Thinking off (thinking_budget=0) for the router and the formatter, instead of
# thinking_level=LOW (gub_agent/config.py has the replay behind it: the router's
# TTFT p90 3.2 s -> 1.1 s). 1 is the config.py default; 0 is each one's ROLLBACK,
# LOW as before. Read at import: a redeploy either way.
#
# The formatter at budget 0 was not replayed for quality. Watch `format_gate:
# attempt … rejected … tenant=…` against `model_call: agent=formatter` after a
# deploy — a rise means the renderer needed the thinking; set its flag to 0.
ROUTER_THINKING_OFF=1
FORMATTER_THINKING_OFF=1
