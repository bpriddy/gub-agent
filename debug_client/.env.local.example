# debug_client — copy to .env.local (gitignored). No secrets belong here:
# the Vertex AI credential is your ADC, the GUB credential is the browser
# sign-in.

# GUB backend the /gub/* rewrite proxies to (sign-in, token refresh).
GUB_BACKEND_URL=http://localhost:3000

# Google OAuth client used by the GUB frontend; http://localhost:3002 must be
# in its Authorized JavaScript origins and in GUB's trusted_apps.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Agent Engine ──────────────────────────────────────────────────────────
GCP_PROJECT_ID=os-test-491819
GCP_REGION=us-central1

# The PRODUCTION engine (serves the Chat bot). SANDBOX_ENABLED=0 is baked in,
# so it ignores every sandbox config — an experiment sent here is a no-op.
AGENT_ENGINE_ID=9136379226620952576

# The SANDBOX engine (deploy-sandbox.env → deployment/deploy-sandbox.sh).
# When set, it is the default target: the UI's engine badge shows which one is
# active and turns red on prod.
SANDBOX_AGENT_ENGINE_ID=9148206673200939008

# Optional. Force the target: "sandbox" or "prod". Unset → sandbox when
# SANDBOX_AGENT_ENGINE_ID is set, else prod.
# AGENT_ENGINE_TARGET=sandbox

# ── Optional fallbacks for GET /api/config ────────────────────────────────
# The option lists come from the engine's own baked-in env when it can be read
# (aiplatform.reasoningEngines.get). If it cannot, these are used, and if they
# are unset too, the config.py defaults mirrored in src/lib/sandbox.ts are.
# Keep them equal to deploy-sandbox.env.
# SANDBOX_MODEL_ALLOWLIST=gemini-3.5-flash,gemini-2.5-pro
# SANDBOX_THINKING_LEVEL_MODELS=gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash
